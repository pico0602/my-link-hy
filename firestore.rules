rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. 사용자 문서 (users/{userId})
    match /users/{userId} {
      // 공개 프로필([displayName]) 조회 및 타 사용자 확인을 위해 누구나 읽기 허용
      allow read: if true;
      // 본인 계정만 생성/수정/삭제 가능
      allow write: if request.auth != null && request.auth.uid == userId;

      // 사용자 프로필 서브컬렉션 (users/{userId}/profile/profile)
      match /profile/{profileDoc} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // 사용자 링크 서브컬렉션 (users/{userId}/links/{linkId})
      match /links/{linkId} {
        // 링크 목록은 누구나 읽기 허용 (공개 프로필 및 통계 조회)
        allow read: if true;
        
        // 링크 생성 및 삭제는 본인만 가능
        allow create, delete: if request.auth != null && request.auth.uid == userId;
        
        // 링크 수정: 본인이거나, 외부 방문자의 클릭 수(clickCount, clicks, lastClickedAt) 증가 업데이트 허용
        allow update: if (request.auth != null && request.auth.uid == userId)
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['clickCount', 'clicks', 'lastClickedAt'])
          );
      }
    }

    // 2. username 중복 방지 및 빠른 조회를 위한 usernames 인덱스 컬렉션
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. 익명 사용자(anonymous) fallback 지원
    match /users/anonymous/{document=**} {
      allow read, write: if true;
    }
  }
}
